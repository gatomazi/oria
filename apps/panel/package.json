{
  "name": "oria-panel",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "migrate": "node-pg-migrate --migrations-dir migrations --ignore-pattern \"(README\\.md|sql|sql/.*)\"",
    "migrate:up": "node-pg-migrate --migrations-dir migrations --ignore-pattern \"(README\\.md|sql|sql/.*)\" up",
    "migrate:down": "node-pg-migrate --migrations-dir migrations --ignore-pattern \"(README\\.md|sql|sql/.*)\" down",
    "migrate:create": "node-pg-migrate --migrations-dir migrations --ignore-pattern \"(README\\.md|sql|sql/.*)\" create",
    "migrate:dry": "node-pg-migrate --migrations-dir migrations --ignore-pattern \"(README\\.md|sql|sql/.*)\" --dry-run up",
    "test": "node scripts/test-db.mjs run -- node --test --test-concurrency=1 test/*.test.js test/invariants/*.test.js",
    "test:invariants": "node scripts/test-db.mjs run -- node --test --test-concurrency=1 test/invariants/*.test.js",
    "test:app-role": "TEST_APP_ROLE=1 node scripts/test-db.mjs run -- node --test --test-concurrency=1 test/*.test.js test/invariants/*.test.js",
    "productization:gate": "node scripts/productization/gate.mjs",
    "release:preflight": "node scripts/release/preflight.mjs",
    "auth:bootstrap-owner": "node scripts/auth/bootstrap-owner.mjs",
    "auth:hash-password": "node scripts/auth/hash-password.mjs",
    "tenancy:seed-entitlements": "node scripts/tenancy/seed-entitlements.mjs",
    "tenancy:mover-criativos": "node scripts/tenancy/mover-criativos.mjs",
    "integrations:import-legacy": "node scripts/integrations/import-legacy.mjs",
    "integrations:reencrypt": "node scripts/integrations/reencrypt.mjs",
    "integrations:import-whatsapp-sender": "node scripts/integrations/import-whatsapp-sender.mjs",
    "integrations:whatsapp-referencia": "node scripts/integrations/whatsapp-referencia.mjs",
    "tenant1:preflight": "node scripts/tenant1/cli.mjs preflight",
    "tenant1:plan": "node scripts/tenant1/cli.mjs plan",
    "tenant1:apply": "node scripts/tenant1/cli.mjs apply",
    "tenant1:verify": "node scripts/tenant1/cli.mjs verify",
    "tenant1:rollback": "node scripts/tenant1/cli.mjs rollback",
    "db:start": "node scripts/test-db.mjs start",
    "db:stop": "node scripts/test-db.mjs stop",
    "build": "npm --prefix admin install && npm --prefix admin run build",
    "postinstall": "npm --prefix admin install && npm --prefix admin run build",
    "extract": "node extract.mjs",
    "extract:usesul": "node extract.mjs --brand usesul",
    "extract:usecentro": "node extract.mjs --brand usecentro",
    "extract:usenorte": "node extract.mjs --brand usenorte",
    "warm": "node scripts/warm-images.mjs",
    "warm:fast": "node scripts/warm-images.mjs --concurrency 12 --limit 500",
    "extract:gentilico": "node extract-gentilico.mjs",
    "extract:gentilico:dry": "node extract-gentilico.mjs usesul --dry",
    "test:unit": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "serve": "^14.2.4",
    "sharp": "^0.33.5"
  }
}
