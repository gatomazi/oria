{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/FeedbackSnapshot.schema.json",
  "title": "FeedbackSnapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "creative_id",
    "plan_id",
    "plan_schema_version",
    "prompt_version",
    "prompt_sha256",
    "mode",
    "objective",
    "strategy",
    "angle",
    "product_ids",
    "subjects",
    "people_count",
    "context",
    "placement",
    "minor_safety_applied",
    "flags",
    "model"
  ],
  "properties": {
    "creative_id": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "compiler_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "prompt_version": {
      "type": "integer"
    },
    "prompt_sha256": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "creative"
      ]
    },
    "objective": {
      "type": "string",
      "enum": [
        "clean_creative",
        "remarketing",
        "funnel_visual"
      ]
    },
    "strategy": {
      "type": "string"
    },
    "angle": {
      "type": "string"
    },
    "product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "people_count": {
      "type": "integer",
      "minimum": 0
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "placement": {
      "type": "string"
    },
    "quality": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "gaze_mode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "minor_safety_applied": {
      "type": "boolean"
    },
    "flags": {
      "type": "object",
      "additionalProperties": true
    },
    "model": {
      "type": "object",
      "additionalProperties": true
    },
    "asset_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
