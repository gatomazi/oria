{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/CreativeProduct.schema.json",
  "title": "CreativeProduct",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "type",
    "referenceImages"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "brandId": {
      "type": "string",
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "referenceImages": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "minItems": 1,
      "maxItems": 4
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
