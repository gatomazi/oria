{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/CreativePlan.schema.json",
  "title": "CreativePlan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "creative_id",
    "schema_version",
    "strategy",
    "internal_strategy_id",
    "product_mode",
    "products",
    "angle",
    "placement",
    "context",
    "brand_kit",
    "niche_kit",
    "overlay",
    "copy",
    "references",
    "prompt",
    "model",
    "versions",
    "validations",
    "warnings"
  ],
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "creative_id": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer"
    },
    "strategy": {
      "type": "string",
      "enum": [
        "CLEAN_ANGLES",
        "REMARKETING",
        "FUNNEL_VISUAL"
      ]
    },
    "internal_strategy_id": {
      "type": "string"
    },
    "product_mode": {
      "type": "string",
      "enum": [
        "single_product",
        "multi_product"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CreativeProduct"
      },
      "minItems": 1
    },
    "angle": {
      "$ref": "#/$defs/Angle"
    },
    "angle_recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AngleRecommendation"
        },
        {
          "type": "null"
        }
      ]
    },
    "placement": {
      "$ref": "#/$defs/Placement"
    },
    "persona": {
      "anyOf": [
        {
          "$ref": "#/$defs/Persona"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "$ref": "#/$defs/ResolvedContext"
    },
    "brand_kit": {
      "$ref": "#/$defs/KitRef"
    },
    "niche_kit": {
      "$ref": "#/$defs/KitRef"
    },
    "funnel_stage": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "TOFU",
            "MOFU",
            "BOFU"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "remarketing_intent": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "site_visitor",
            "product_view",
            "collection_discovery",
            "cart",
            "checkout",
            "social_proof",
            "objection"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "layout": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "overlay": {
      "$ref": "#/$defs/OverlaySpec"
    },
    "copy": {
      "$ref": "#/$defs/CopyOptions"
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReferenceRole"
      }
    },
    "prompt": {
      "$ref": "#/$defs/PromptInfo"
    },
    "model": {
      "$ref": "#/$defs/ModelSelection"
    },
    "versions": {
      "type": "object",
      "additionalProperties": true
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ValidationCheck"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "creative"
      ]
    },
    "objective": {
      "type": "string",
      "enum": [
        "clean_creative",
        "remarketing",
        "funnel_visual"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanSubject"
      }
    },
    "scene": {
      "$ref": "#/$defs/PlanScene"
    },
    "composition": {
      "$ref": "#/$defs/PlanComposition"
    },
    "minor_safety": {
      "$ref": "#/$defs/MinorSafety"
    },
    "semantics": {
      "$ref": "#/$defs/PlanSemantics"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "provenance_sources": {
      "type": "object",
      "additionalProperties": true
    },
    "resolved_inputs": {
      "$ref": "#/$defs/ResolvedInputs"
    },
    "compiler": {
      "$ref": "#/$defs/CompilerInfo"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "Angle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "uses_person",
        "apparel_only",
        "multi_product_limit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "IDENTIDADE_ORIGEM",
            "LIFESTYLE_COTIDIANO",
            "ORGULHO_DISCRETO",
            "PERTENCIMENTO",
            "NOSTALGIA_ORIGEM",
            "CABIDE",
            "PRODUTO_ESTAMPA",
            "CAIMENTO",
            "CLOSE_ESTAMPA",
            "CLOSE_BOLSO",
            "PREMIUM_ESTILO",
            "CREATOR_STYLE",
            "PRESENTE_AFETO"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "uses_person": {
          "type": "boolean"
        },
        "apparel_only": {
          "type": "boolean"
        },
        "multi_product_limit": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "AngleRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle_id",
        "family",
        "scope",
        "version",
        "source"
      ],
      "properties": {
        "angle_id": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "enum": [
            "lifestyle",
            "connection",
            "editorial_portrait",
            "action_movement",
            "product_focus",
            "product_no_person",
            "creator_social"
          ]
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": "string",
          "enum": [
            "system",
            "organization",
            "store"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "product",
            "product_enrichment",
            "brand",
            "niche",
            "persona",
            "angle",
            "planner_default",
            "safety_policy"
          ]
        },
        "custom_angle": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomAngle"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "CompilerInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sections"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompilerSection"
          }
        }
      }
    },
    "CompilerSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "source",
        "value",
        "length"
      ],
      "properties": {
        "section": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "value": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CopyOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate"
      ],
      "properties": {
        "generate": {
          "type": "boolean"
        },
        "funnel_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TOFU",
              "MOFU",
              "BOFU"
            ]
          },
          "maxItems": 3
        }
      }
    },
    "CreativeProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "referenceImages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "brandId": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "referenceImages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 4
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "semantic_context": {
          "$ref": "#/$defs/ProductSemanticContext"
        }
      }
    },
    "CustomAngle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "organization_id",
        "slug",
        "name",
        "family",
        "people_mode",
        "active",
        "version",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "organization",
            "store"
          ]
        },
        "organization_id": {
          "type": "string"
        },
        "store_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "lifestyle",
            "connection",
            "editorial_portrait",
            "action_movement",
            "product_focus",
            "product_no_person",
            "creator_social"
          ]
        },
        "people_mode": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "preset": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 60
            },
            {
              "type": "null"
            }
          ]
        },
        "definition": {
          "type": "object",
          "additionalProperties": true
        },
        "allowed_interactions": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "allowed_product_modes": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "single_product",
                  "multi_product"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "default_gaze": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "camera",
                "interaction",
                "off_camera",
                "product",
                "none"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "active": {
          "type": "boolean"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "created_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        }
      }
    },
    "GazeResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "requested",
        "source",
        "reason"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "camera",
            "interaction",
            "off_camera",
            "product",
            "none"
          ]
        },
        "requested": {
          "type": "string",
          "enum": [
            "camera",
            "interaction",
            "off_camera",
            "product",
            "auto"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "product",
            "product_enrichment",
            "brand",
            "niche",
            "persona",
            "angle",
            "planner_default",
            "safety_policy"
          ]
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "KitRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      }
    },
    "MinorSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applies",
        "minor_subject_ids",
        "global"
      ],
      "properties": {
        "applies": {
          "type": "boolean"
        },
        "minor_subject_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "global": {
          "type": "object",
          "additionalProperties": true
        },
        "brand": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ModelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "model",
        "quality",
        "size"
      ],
      "properties": {
        "task": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "size": {
          "type": "string"
        }
      }
    },
    "OverlaySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "clean"
      ],
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "subheadline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "cta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "search_bar_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chips": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text_density": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "minimal",
                "balanced",
                "commercial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cta_emphasis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "subtle",
                "medium",
                "strong"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "clean": {
          "type": "boolean"
        }
      }
    },
    "Persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "age_range": {
          "type": "string",
          "maxLength": 80
        },
        "appearance": {
          "type": "string",
          "maxLength": 1000
        },
        "style": {
          "type": "string",
          "maxLength": 1000
        },
        "behavior": {
          "type": "string",
          "maxLength": 1000
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": [
            "automatic",
            "custom"
          ]
        },
        "age_band": {
          "type": "string",
          "enum": [
            "baby",
            "child",
            "child_3_5",
            "child_6_9",
            "child_10_12",
            "teen",
            "adult",
            "senior",
            "unknown"
          ]
        }
      }
    },
    "Placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "width",
        "height",
        "api_size"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "FEED_4X5",
            "STORY_9X16"
          ]
        },
        "label": {
          "type": "string"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "api_size": {
          "type": "string"
        }
      }
    },
    "PlanComposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "people_count",
        "pose_risk",
        "risk_reasons"
      ],
      "properties": {
        "people_count": {
          "type": "integer",
          "minimum": 0
        },
        "pose_risk": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "risk_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PlanScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gaze",
        "picks",
        "prompt_version"
      ],
      "properties": {
        "gaze": {
          "$ref": "#/$defs/GazeResolution"
        },
        "picks": {
          "type": "object",
          "additionalProperties": true
        },
        "prompt_version": {
          "type": "integer"
        },
        "interaction": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "interaction_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "user",
                "product",
                "product_enrichment",
                "brand",
                "niche",
                "persona",
                "angle",
                "planner_default",
                "safety_policy"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "interaction_detail": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "scene_mode": {
          "type": "string",
          "enum": [
            "template",
            "frame"
          ]
        },
        "composition_source": {
          "type": "string",
          "enum": [
            "explicit",
            "recommended",
            "legacy"
          ]
        }
      }
    },
    "PlanSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "products",
        "warnings"
      ],
      "properties": {
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "supporting": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "PlanSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "label",
        "age_band",
        "is_minor",
        "product_use",
        "prominence",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "supporting"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "persona": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "age_band": {
          "type": "string",
          "enum": [
            "baby",
            "child",
            "child_3_5",
            "child_6_9",
            "child_10_12",
            "teen",
            "adult",
            "senior",
            "unknown"
          ]
        },
