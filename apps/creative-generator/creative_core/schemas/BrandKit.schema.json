{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/BrandKit.schema.json",
  "title": "BrandKit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "schemaVersion",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "positioning": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "tone": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "visualStyle": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "colors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "typographyNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "preferredContexts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "avoid": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "manualNotes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "enabledAngles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "IDENTIDADE_ORIGEM",
          "LIFESTYLE_COTIDIANO",
          "ORGULHO_DISCRETO",
          "PERTENCIMENTO",
          "NOSTALGIA_ORIGEM",
          "CABIDE",
          "PRODUTO_ESTAMPA",
          "CAIMENTO",
          "CLOSE_ESTAMPA",
          "CLOSE_BOLSO",
          "PREMIUM_ESTILO",
          "CREATOR_STYLE",
          "PRESENTE_AFETO"
        ]
      }
    },
    "angleLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "headlineStyle": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "ctaStyle": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "maxItems": 100
    },
    "strategyRules": {
      "type": "object",
      "additionalProperties": true
    },
    "defaultNicheKitId": {
      "type": "string",
      "maxLength": 120
    },
    "defaultContextProvider": {
      "type": "string",
      "enum": [
        "geographic",
        "niche",
        "custom"
      ]
    },
    "suggestedPersonas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Persona"
      },
      "maxItems": 50
    },
    "minorWardrobePolicy": {
      "$ref": "#/$defs/MinorWardrobePolicy"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "MinorWardrobePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "legs_coverage": {
          "type": "string",
          "enum": [
            "full",
            "knee",
            "default"
          ]
        },
        "allow_short_shorts": {
          "type": "boolean"
        },
        "allow_short_skirts": {
          "type": "boolean"
        },
        "allow_revealing_clothing": {
          "type": "boolean"
        },
        "style": {
          "type": "string",
          "maxLength": 60
        }
      }
    },
    "Persona": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "age_range": {
          "type": "string",
          "maxLength": 80
        },
        "appearance": {
          "type": "string",
          "maxLength": 1000
        },
        "style": {
          "type": "string",
          "maxLength": 1000
        },
        "behavior": {
          "type": "string",
          "maxLength": 1000
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "source": {
          "type": "string",
          "enum": [
            "automatic",
            "custom"
          ]
        },
        "age_band": {
          "type": "string",
          "enum": [
            "baby",
            "child",
            "child_3_5",
            "child_6_9",
            "child_10_12",
            "teen",
            "adult",
            "senior",
            "unknown"
          ]
        }
      }
    }
  }
}
