{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/CustomAngle.schema.json",
  "title": "CustomAngle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "scope",
    "organization_id",
    "slug",
    "name",
    "family",
    "people_mode",
    "active",
    "version",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "organization",
        "store"
      ]
    },
    "organization_id": {
      "type": "string"
    },
    "store_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "family": {
      "type": "string",
      "enum": [
        "lifestyle",
        "connection",
        "editorial_portrait",
        "action_movement",
        "product_focus",
        "product_no_person",
        "creator_social"
      ]
    },
    "people_mode": {
      "type": "string",
      "enum": [
        "none",
        "optional",
        "required"
      ]
    },
    "preset": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": true
    },
    "allowed_interactions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "allowed_product_modes": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "single_product",
              "multi_product"
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "default_gaze": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "camera",
            "interaction",
            "off_camera",
            "product",
            "none"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  }
}
