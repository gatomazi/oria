        },
        "context_id": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "ContextSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "CopyOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate"
      ],
      "properties": {
        "generate": {
          "type": "boolean"
        },
        "funnel_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "TOFU",
              "MOFU",
              "BOFU"
            ]
          },
          "maxItems": 3
        }
      }
    },
    "CreativeProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "referenceImages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
