        "brandId": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "referenceImages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 4
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        },
        "semantic_context": {
          "$ref": "#/$defs/ProductSemanticContext"
        }
      }
    },
    "FunnelOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "headline": {
          "type": "string",
          "maxLength": 120
        },
        "subheadline": {
          "type": "string",
          "maxLength": 200
        },
        "cta": {
          "type": "string",
          "maxLength": 60
        },
        "badges": {
