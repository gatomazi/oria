        "text_density": {
          "type": "string",
          "enum": [
            "minimal",
            "balanced",
            "commercial"
          ]
        },
        "cta_emphasis": {
          "type": "string",
          "enum": [
            "subtle",
            "medium",
            "strong"
          ]
        },
        "clean_mode": {
          "type": "boolean"
        }
