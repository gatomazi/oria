            "type": "string",
            "maxLength": 40
          },
          "maxItems": 3
        },
        "benefits": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "maxItems": 3
        },
        "search_bar_text": {
          "type": "string",
          "maxLength": 80
        },
        "chips": {
          "type": "array",
