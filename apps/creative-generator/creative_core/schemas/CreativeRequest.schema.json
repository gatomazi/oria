{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-core/v1/CreativeRequest.schema.json",
  "title": "CreativeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "strategy",
    "product_mode",
    "products",
    "angle_id",
    "placement_id"
  ],
  "properties": {
    "creative_id": {
      "type": "string",
      "maxLength": 120
    },
    "strategy": {
      "type": "string",
      "enum": [
        "CLEAN_ANGLES",
        "REMARKETING",
        "FUNNEL_VISUAL"
      ]
    },
    "product_mode": {
      "type": "string",
      "enum": [
        "single_product",
        "multi_product"
      ]
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CreativeProduct"
      },
      "minItems": 1,
      "maxItems": 6
    },
    "brand_kit": {
      "$ref": "#/$defs/BrandKit"
    },
    "brand_kit_id": {
      "type": "string",
      "maxLength": 120
    },
    "niche_kit": {
      "$ref": "#/$defs/NicheKit"
    },
    "niche_kit_id": {
      "type": "string",
      "maxLength": 120
    },
    "angle_id": {
      "type": "string",
      "enum": [
        "IDENTIDADE_ORIGEM",
        "LIFESTYLE_COTIDIANO",
        "ORGULHO_DISCRETO",
        "PERTENCIMENTO",
        "NOSTALGIA_ORIGEM",
        "CABIDE",
        "PRODUTO_ESTAMPA",
        "CAIMENTO",
        "CLOSE_ESTAMPA",
        "CLOSE_BOLSO",
        "PREMIUM_ESTILO",
        "CREATOR_STYLE",
        "PRESENTE_AFETO"
      ]
    },
    "placement_id": {
      "type": "string",
      "enum": [
        "FEED_4X5",
        "STORY_9X16"
      ]
    },
    "persona_mode": {
      "type": "string",
      "enum": [
        "automatic",
        "custom",
        "none"
      ]
    },
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "context": {
      "$ref": "#/$defs/ContextSelection"
    },
    "funnel_stage": {
      "type": "string",
      "enum": [
        "TOFU",
        "MOFU",
        "BOFU"
      ]
    },
    "remarketing": {
      "$ref": "#/$defs/RemarketingOptions"
    },
    "funnel": {
      "$ref": "#/$defs/FunnelOptions"
    },
    "copy": {
      "$ref": "#/$defs/CopyOptions"
    },
    "quality": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "history_hints": {
      "$ref": "#/$defs/HistoryHints"
    },
    "prompt_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "plan_schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "gaze_mode": {
      "type": "string",
      "enum": [
        "camera",
        "interaction",
        "off_camera",
        "product",
        "auto"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RequestSubject"
      },
      "maxItems": 4
    },
    "interaction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "scene_picks": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "BrandKit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
