        "positioning": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "audience": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "tone": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "visualStyle": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "typographyNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "preferredContexts": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "manualNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "enabledAngles": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "IDENTIDADE_ORIGEM",
              "LIFESTYLE_COTIDIANO",
              "ORGULHO_DISCRETO",
              "PERTENCIMENTO",
              "NOSTALGIA_ORIGEM",
              "CABIDE",
              "PRODUTO_ESTAMPA",
              "CAIMENTO",
              "CLOSE_ESTAMPA",
              "CLOSE_BOLSO",
              "PREMIUM_ESTILO",
              "CREATOR_STYLE",
              "PRESENTE_AFETO"
            ]
          }
        },
        "angleLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "headlineStyle": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "ctaStyle": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 500
          },
          "maxItems": 100
        },
        "strategyRules": {
          "type": "object",
          "additionalProperties": true
        },
        "defaultNicheKitId": {
          "type": "string",
          "maxLength": 120
        },
        "defaultContextProvider": {
          "type": "string",
          "enum": [
            "geographic",
            "niche",
            "custom"
          ]
        },
        "suggestedPersonas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Persona"
          },
          "maxItems": 50
        },
        "minorWardrobePolicy": {
          "$ref": "#/$defs/MinorWardrobePolicy"
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ContextProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contextId",
        "contextType",
        "subject",
        "status",
        "schemaVersion",
        "promptVersion",
        "profileVersion"
      ],
      "properties": {
        "contextId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
