+
+// Conexão ≠ entitlement: isto NÃO olha o plano, e `exigirFeature` NÃO olha isto. `inkConectada()`
+// já cobre o fallback de env legada (vai por `temSegredo`), então o guard não aperta ninguém que
+// hoje opera por env.
+async function CONNECTOR_CONECTADO(provider) {
+  if (provider === 'ink') return inkConectada();
+  return false;
+}
+const GUARDS_DE_CAPABILITY = new Map();
+function exigirCapability(chave) {
+  if (!GUARDS_DE_CAPABILITY.has(chave)) {
+    GUARDS_DE_CAPABILITY.set(chave, requireCapability(CONNECTOR_CONECTADO, chave));
+  }
+  return GUARDS_DE_CAPABILITY.get(chave);
+}

