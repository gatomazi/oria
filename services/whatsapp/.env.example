# Ambiente. "production" liga o fail-fast do boot: as variáveis marcadas como
# obrigatórias em produção passam a derrubar o processo se estiverem faltando.
# No Railway, RAILWAY_ENVIRONMENT_NAME já cumpre esse papel sozinha.
# Vazio/ausente = development: o serviço sobe sem esses segredos, mas continua
# recusando todo webhook sem assinatura válida.
APP_ENV=development

# Obrigatórias em qualquer ambiente
META_PHONE_NUMBER_ID=123456789
META_ACCESS_TOKEN=EAAxxxxxxxx
META_VERIFY_TOKEN=meu-token-secreto

# Obrigatórias EM PRODUÇÃO (sem elas o processo aborta no boot). Fora de produção
# são opcionais, mas cada controle continua fail-closed sem elas:
#   META_APP_SECRET ausente -> todo POST em /webhook responde 403
#   API_KEY ausente         -> todo endpoint não público responde 401
#   DATABASE_URL ausente    -> dados só em memória, perdidos no restart
META_APP_SECRET=segredo-do-app-da-meta
API_KEY=minha-chave-api
DATABASE_URL=

# Opcional — repassa ao painel as changes com dono (POST /api/webhooks/whatsapp).
# A URL NÃO pode ter query string, credencial nem fragmento (o antigo ?secret= é
# recusado; em produção derruba o boot). Cada repasse é assinado em header com
# WEBHOOK_FORWARD_SECRET (>= 32 caracteres), o mesmo valor de
# WHATSAPP_WEBHOOK_SECRET no painel. URL sem segredo: produção aborta, dev desliga.
WEBHOOK_FORWARD_URL=
WEBHOOK_FORWARD_SECRET=

# Auto-resposta: quando um cliente responde ao número da API, envia um texto
# redirecionando para o atendimento humano. Deixe REPLY_REDIRECT_NUMBER vazio
# (e REPLY_REDIRECT_MESSAGE vazio) para desativar.
REPLY_REDIRECT_NUMBER=5548988082581
# Opcional — texto da auto-resposta (se vazio, usa um padrão com o link wa.me)
REPLY_REDIRECT_MESSAGE=
# Opcional — intervalo mínimo (minutos) entre auto-respostas para o mesmo número
REPLY_COOLDOWN_MINUTES=360

# Opcionais com padrão
META_API_VERSION=v21.0
PORT=8080
